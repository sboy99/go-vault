# Base URL for the go-vault API. In development, default `/api` is proxied
# to VITE_API_PROXY (see vite.config.ts) so CORS is not required.
VITE_API_BASE_URL=/api

# Upstream target for the Vite `/api` proxy (dev only).
VITE_API_PROXY=http://localhost:8080

# Optional seed for the bearer token. Overridden by Settings / localStorage.
VITE_API_TOKEN=
